# ============================================================
# pi-grok-search 配置模板
# 复制为 ~/.config/grok-search/env 并填入真实值（或直接导出为环境变量）
# 读取优先级: 进程环境变量 > ~/.config/grok-search/env
# ============================================================

# ---- 必填: Grok API（OpenAI 兼容 chat/completions 端点）----
# 官方: https://api.x.ai/v1 （需 xAI API Key）
# 或任意 OpenAI 兼容代理端点
GROK_API_URL="https://api.x.ai/v1"
GROK_API_KEY="<your-xai-api-key>"

# ---- 可选: 模型与模式 ----
# GROK_MODEL 默认 "grok-2-latest"；OpenRouter 端点会自动追加 :online 后缀
# GROK_MODEL="grok-2-latest"
# API 模式: chat | responses（xAI 官方推荐 responses 以获得带 citation 的联网回答）
# GROK_API_MODE="chat"
# 推理强度: low | medium | high
# GROK_REASONING_EFFORT="medium"

# ---- 可选: 调试与重试 ----
# GROK_DEBUG="false"
# GROK_RETRY_MAX_ATTEMPTS="3"
# GROK_RETRY_MULTIPLIER="1"
# GROK_RETRY_MAX_WAIT="10"

# ---- 可选: Tavily（web_fetch/web_map 的信源抓取）----
# TAVILY_ENABLED="true"
# TAVILY_API_URL="https://api.tavily.com"
# TAVILY_API_KEY="<your-tavily-api-key>"

# ---- 可选: Firecrawl（web_fetch 抓取降级链路）----
# FIRECRAWL_API_URL="https://api.firecrawl.dev/v2"
# FIRECRAWL_API_KEY="<your-firecrawl-api-key>"
